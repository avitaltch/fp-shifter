# Public browser configuration for compose.yaml.
# Use your self-hosted Supabase public gateway URL and publishable key.
APP_SUPABASE_URL=https://supabase.example.com
APP_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional during migration; required by pages moved to the NestJS API.
APP_API_URL=https://api.example.com/api/v1

# Host port for the ShiftSync web container.
APP_PORT=8080
