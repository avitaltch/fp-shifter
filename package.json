{
  "name": "fp-shifter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "api:dev": "npm --prefix apps/api run dev",
    "api:lint": "npm --prefix apps/api run lint",
    "api:typecheck": "npm --prefix apps/api run typecheck",
    "api:test": "npm --prefix apps/api run test",
    "api:test:integration": "npm --prefix apps/api run test:integration",
    "api:benchmark:scheduler": "npm --prefix apps/api run benchmark:scheduler",
    "api:build": "npm --prefix apps/api run build",
    "mvp:up": "docker compose -f compose.mvp.yaml up --build",
    "mvp:down": "docker compose -f compose.mvp.yaml down",
    "mvp:seed": "docker compose -f compose.mvp.yaml --profile tools run --rm --build seed",
    "sql:generate": "node scripts/generate-install-sql.mjs",
    "sql:check": "node scripts/generate-install-sql.mjs --check",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.1",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "oxlint": "^1.69.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.10"
  }
}
