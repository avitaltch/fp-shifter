NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
DATABASE_URL=postgres://shiftsync:shiftsync_local@127.0.0.1:54320/shiftsync
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SWAGGER_ENABLED=true
MANAGEMENT_TOKEN_SECRET=replace-with-at-least-32-random-bytes
MANAGEMENT_TOKEN_TTL_DAYS=365
AUTH_TOKEN_SECRET=replace-with-a-different-32-byte-random-secret
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_LOGIN_IP_LIMIT=20
AUTH_LOGIN_EMAIL_LIMIT=5
AUTH_LOGIN_WINDOW_SECONDS=900
PUBLIC_BOOKING_IP_LIMIT=20
PUBLIC_BOOKING_IP_WINDOW_SECONDS=300
PUBLIC_BOOKING_CONTACT_LIMIT=5
PUBLIC_BOOKING_CONTACT_WINDOW_SECONDS=3600
WAITLIST_OFFER_TTL_SECONDS=300
NOTIFICATION_WORKER_BATCH_SIZE=50
NOTIFICATION_WORKER_LEASE_SECONDS=300
NOTIFICATION_WORKER_POLL_MS=1000
